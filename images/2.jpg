<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%">
  <defs>
    <linearGradient id="skyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFCAD4"/>
      <stop offset="35%" stop-color="#FFE5D9"/>
      <stop offset="70%" stop-color="#FFD6A5"/>
      <stop offset="100%" stop-color="#FDFFB6"/>
    </linearGradient>
    <linearGradient id="sunGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFF176"/>
      <stop offset="100%" stop-color="#FFB74D"/>
    </linearGradient>
  </defs>
  <!-- Sunset Sky -->
  <rect width="500" height="500" fill="url(#skyGrad)"/>
  
  <!-- Sun -->
  <circle cx="250" cy="230" r="90" fill="url(#sunGrad)" opacity="0.9"/>
  <circle cx="250" cy="230" r="110" fill="#FFF9C4" opacity="0.3"/>

  <!-- Birds -->
  <path d="M 120 120 Q 130 110 140 120 Q 150 110 160 120" fill="none" stroke="#6D597A" stroke-width="2.5" stroke-linecap="round"/>
  <path d="M 155 140 Q 163 132 170 140 Q 178 132 185 140" fill="none" stroke="#6D597A" stroke-width="2" stroke-linecap="round"/>

  <!-- Distant Mountains -->
  <path d="M 0 310 Q 120 250 220 290 Q 320 240 500 320 L 500 500 L 0 500 Z" fill="#E5989B" opacity="0.7"/>
  <!-- Closer Hills -->
  <path d="M 0 350 Q 160 300 290 350 Q 400 310 500 360 L 500 500 L 0 500 Z" fill="#B56576" opacity="0.8"/>

  <!-- Road winding through -->
  <path d="M 240 340 L 260 340 L 370 500 L 130 500 Z" fill="#6D597A"/>
  <!-- Road dashed line -->
  <path d="M 250 345 L 250 500" stroke="#FFF176" stroke-width="4" stroke-dasharray="14 16"/>

  <!-- Retro car on road -->
  <g transform="translate(225, 400) scale(0.65)">
    <!-- Car body -->
    <rect x="-40" y="20" width="80" height="35" rx="10" fill="#F4A261"/>
    <path d="M -25 20 L -15 -5 L 15 -5 L 25 20 Z" fill="#E76F51"/>
    <rect x="-18" y="0" width="36" height="18" rx="3" fill="#E0FBFC"/>
    <!-- Wheels -->
    <circle cx="-25" cy="55" r="12" fill="#264653"/>
    <circle cx="25" cy="55" r="12" fill="#264653"/>
    <circle cx="-25" cy="55" r="5" fill="#E9C46A"/>
    <circle cx="25" cy="55" r="5" fill="#E9C46A"/>
    <!-- Headlights -->
    <circle cx="-35" cy="35" r="5" fill="#FFE3E0"/>
    <circle cx="35" cy="35" r="5" fill="#FFE3E0"/>
  </g>

  <text x="250" y="470" font-family="'Caveat', cursive, sans-serif" font-size="28" fill="#F8EDEB" text-anchor="middle" font-weight="bold">Golden hour adventures 🚗✨</text>
</svg>