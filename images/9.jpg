<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="100%" height="100%">
  <defs>
    <linearGradient id="mem3Bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFE5D9"/>
      <stop offset="100%" stop-color="#FFD6A5"/>
    </linearGradient>
  </defs>
  <rect width="600" height="400" rx="16" fill="url(#mem3Bg)"/>

  <!-- Vintage Suitcase -->
  <g transform="translate(200, 200)">
    <rect x="-90" y="-50" width="180" height="110" rx="14" fill="#9C6644" stroke="#7F5539" stroke-width="4"/>
    <!-- Suitcase leather straps -->
    <rect x="-55" y="-50" width="18" height="110" fill="#7F5539"/>
    <rect x="35" y="-50" width="18" height="110" fill="#7F5539"/>
    <!-- Gold buckles -->
    <rect x="-57" y="-5" width="22" height="15" rx="3" fill="#FFD166"/>
    <rect x="33" y="-5" width="22" height="15" rx="3" fill="#FFD166"/>
    <!-- Handle -->
    <path d="M -30 -50 C -30 -80 30 -80 30 -50" fill="none" stroke="#7F5539" stroke-width="8" stroke-linecap="round"/>
    <!-- Travel stamps on suitcase -->
    <circle cx="-15" cy="20" r="18" fill="#F4A261" opacity="0.9"/>
    <text x="-15" y="24" font-family="sans-serif" font-size="10" fill="#FFF" text-anchor="middle" font-weight="bold">PARIS</text>
    <rect x="2" y="-30" width="25" height="18" rx="2" fill="#E76F51" opacity="0.85"/>
  </g>

  <!-- Boarding Passes / Train Tickets -->
  <g transform="translate(430, 180) rotate(15)">
    <rect x="-70" y="-40" width="140" height="75" rx="6" fill="#FFFFFF" stroke="#E29578" stroke-width="2"/>
    <line x1="30" y1="-40" x2="30" y2="35" stroke="#E29578" stroke-width="2" stroke-dasharray="4 4"/>
    <circle cx="30" cy="-40" r="8" fill="#FFD6A5"/>
    <circle cx="30" cy="35" r="8" fill="#FFD6A5"/>
    <text x="-55" y="-15" font-family="sans-serif" font-size="12" fill="#E29578" font-weight="bold">ADMIT TWO ✈️</text>
    <text x="-55" y="5" font-family="'Caveat', cursive, sans-serif" font-size="16" fill="#7F5539">GATE 07 • DEST: FUN</text>
    <text x="-55" y="25" font-family="monospace" font-size="10" fill="#999">||||||||||||||</text>
  </g>

  <!-- Little Compass -->
  <g transform="translate(360, 250)">
    <circle cx="0" cy="0" r="28" fill="#FFFFFF" stroke="#D4A373" stroke-width="3"/>
    <polygon points="0,-22 6,0 -6,0" fill="#E63946"/>
    <polygon points="0,22 6,0 -6,0" fill="#457B9D"/>
    <circle cx="0" cy="0" r="3" fill="#D4A373"/>
  </g>

  <text x="300" y="345" font-family="'Caveat', cursive, sans-serif" font-size="26" fill="#7F5539" text-anchor="middle">"Lost our map, found the best sunset ever."</text>
</svg>