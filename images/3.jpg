<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%">
  <defs>
    <linearGradient id="grassBg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#E9F5DB"/>
      <stop offset="100%" stop-color="#CFE1B9"/>
    </linearGradient>
    <pattern id="gingham" width="30" height="30" patternUnits="userSpaceOnUse">
      <rect width="30" height="30" fill="#FFF1E6"/>
      <rect width="15" height="15" fill="#FFCAD4" opacity="0.6"/>
      <rect x="15" y="15" width="15" height="15" fill="#FFCAD4" opacity="0.6"/>
      <rect x="15" y="0" width="15" height="15" fill="#FFB4A2" opacity="0.4"/>
      <rect x="0" y="15" width="15" height="15" fill="#FFB4A2" opacity="0.4"/>
    </pattern>
  </defs>
  <!-- Background lawn -->
  <rect width="500" height="500" fill="url(#grassBg)"/>

  <!-- Daisy flowers scattered in grass -->
  <g fill="#FFFFFF">
    <circle cx="60" cy="80" r="14"/>
    <circle cx="430" cy="90" r="12"/>
    <circle cx="80" cy="420" r="10"/>
    <circle cx="440" cy="390" r="13"/>
  </g>
  <g fill="#FFD166">
    <circle cx="60" cy="80" r="6"/>
    <circle cx="430" cy="90" r="5"/>
    <circle cx="80" cy="420" r="4"/>
    <circle cx="440" cy="390" r="5"/>
  </g>

  <!-- Picnic Blanket (Rotated Diamond/Rect) -->
  <g transform="translate(250, 270) rotate(-6)">
    <rect x="-170" y="-140" width="340" height="280" rx="16" fill="url(#gingham)" stroke="#F8EDEB" stroke-width="4"/>
    <!-- Blanket fringe/tassels -->
    <path d="M -160 140 L 160 140" stroke="#FFCAD4" stroke-width="6" stroke-dasharray="4 6"/>
    <path d="M -160 -140 L 160 -140" stroke="#FFCAD4" stroke-width="6" stroke-dasharray="4 6"/>

    <!-- Picnic Basket -->
    <g transform="translate(-70, -30)">
      <rect x="-40" y="-10" width="80" height="60" rx="8" fill="#DDB892" stroke="#B08968" stroke-width="3"/>
      <!-- Basket weave pattern lines -->
      <line x1="-38" y1="10" x2="38" y2="10" stroke="#B08968" stroke-width="2"/>
      <line x1="-38" y1="30" x2="38" y2="30" stroke="#B08968" stroke-width="2"/>
      <line x1="-15" y1="-8" x2="-15" y2="48" stroke="#B08968" stroke-width="2"/>
      <line x1="15" y1="-8" x2="15" y2="48" stroke="#B08968" stroke-width="2"/>
      <!-- Basket lid -->
      <path d="M -45 -10 L 45 -10 L 35 -25 L -35 -25 Z" fill="#E6CCB2" stroke="#B08968" stroke-width="3"/>
      <!-- Handle -->
      <path d="M -30 -25 C -30 -60 30 -60 30 -25" fill="none" stroke="#7F5539" stroke-width="4"/>
    </g>

    <!-- Strawberries & Treats on Plate -->
    <g transform="translate(60, 20)">
      <ellipse cx="0" cy="0" rx="45" ry="35" fill="#FFFFFF" stroke="#E2E2E2" stroke-width="2"/>
      <!-- Strawberries -->
      <path d="M -15 -10 C -15 -25 -5 -25 0 -10 C 5 -25 15 -25 15 -10 C 15 5 0 15 0 15 C 0 15 -15 5 -15 -10 Z" fill="#E63946"/>
      <polygon points="-2,-15 0,-18 2,-15" fill="#588157"/>
      <path d="M 12 5 C 12 -5 20 -5 24 5 C 28 -5 36 -5 36 5 C 36 15 24 25 24 25 C 24 25 12 15 12 5 Z" fill="#FF5D8F"/>
    </g>

    <!-- Two Lemonade Glasses with Straws -->
    <g transform="translate(70, -70)">
      <rect x="-25" y="0" width="20" height="35" rx="3" fill="#FFF3B0" opacity="0.8" stroke="#FFFFFF" stroke-width="2"/>
      <line x1="-15" y1="-12" x2="-15" y2="30" stroke="#FF5D8F" stroke-width="3"/>
      
      <rect x="5" y="5" width="20" height="35" rx="3" fill="#FFF3B0" opacity="0.8" stroke="#FFFFFF" stroke-width="2"/>
      <line x1="15" y1="-7" x2="15" y2="35" stroke="#06D6A0" stroke-width="3"/>
    </g>
  </g>

  <text x="250" y="470" font-family="'Caveat', cursive, sans-serif" font-size="28" fill="#588157" text-anchor="middle" font-weight="bold">Picnic day under the trees 🍓🥪</text>
</svg>